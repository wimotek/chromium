# syntax=docker/dockerfile:1.7

# ==============================================================================
# Pre-Compiled Release Dockerfile
# Packages ONLY pre-compiled & verified `dist/` + `dist-server/` artifacts into
# a minimal multi-arch (linux/amd64, linux/arm64) Node 22 Alpine runtime image.
#
# Usage (compile source FIRST, then build/push):
#   npm run build:all
#   docker buildx build -f Dockerfile.release --platform linux/amd64,linux/arm64 --push -t <image>:<tag> .
# ==============================================================================

# Stage 1: Production Runtime Dependencies Only (pure JS: dotenv, express, nodemailer)
# Runs on native $BUILDPLATFORM to avoid QEMU SIGILL (exit 132) during linux/arm64 multi-arch builds
FROM --platform=$BUILDPLATFORM node:22-alpine AS prod-deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci --omit=dev; else npm install --omit=dev; fi \
  && npm cache clean --force

# Stage 2: Minimal Production Runner (pre-compiled dist/ + dist-server/ only)
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000 \
    HTTPS_PORT=3443 \
    DATA_DIR=/data \
    TLS_CERT_DIR=/certs

RUN apk add --no-cache tini curl su-exec openssl \
  && addgroup -S -g 1001 netpulse \
  && adduser -S -u 1001 -G netpulse netpulse \
  && mkdir -p /data/certs /certs \
  && chown -R netpulse:netpulse /app /data

COPY --from=prod-deps --chown=netpulse:netpulse /app/node_modules ./node_modules
COPY --chown=netpulse:netpulse package.json ./package.json
COPY --chown=netpulse:netpulse dist ./dist
COPY --chown=netpulse:netpulse dist-server ./dist-server
COPY --chmod=755 docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

# Guardrail: fail image build immediately if compiled artifacts are missing
RUN test -f /app/dist/index.html && test -f /app/dist-server/server.mjs

VOLUME ["/data", "/certs"]
EXPOSE 3000 3443

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3000/api/health || exit 1

ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["node", "dist-server/server.mjs"]
