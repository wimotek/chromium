# ==============================================================================
# NetPlus Cloud & DNS Console — Production Self-Hosted Environment Config
# 所有环境变量均为可选且内置默认值，零配置即可直接启动；需要自定义时取消行首 # 注释即可
# ==============================================================================

# [可选] HTTP 监听端口（默认 3000）
# PORT=3000

# [可选] HTTPS 监听端口（默认 3443；设为 0 可关闭内置 HTTPS）
# 提示：命令行检测 HTTPS 请使用 curl -k https://127.0.0.1:3443/api/health
# HTTPS_PORT=3443

# [可选] 外部 SSL 证书只读挂载目录（默认 /certs，支持宝塔 fullchain.pem / privkey.pem）
# TLS_CERT_DIR=/certs

# [可选] 未挂载外部证书时是否自动生成持久化自签证书（默认 true）
# TLS_AUTO_SELF_SIGNED=true

# [可选] 自动自签证书默认 CN（默认 netplus.local）
# TLS_SELF_SIGNED_CN=netplus.local

# [可选] 数据、加密凭据、自签证书与审计日志持久化目录（容器默认 /data，源码本地运行默认 ./data）
# DATA_DIR=/data

# [可选] 首次启动初始管理员账号与密码（仅在数据库尚无管理员时写入一次作为初始值，后续可在 Web 后台修改密码）
# 若 ADMIN_PASSWORD 留空，首次启动将自动生成 16 位随机强密码并一次性打印在容器日志（docker logs netplus）中，不暴露公开创建管理员页面
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-strong-password

# [可选] 64 位十六进制 AES-256 凭据加密密钥（留空则自动生成并持久化保存在 DATA_DIR/.app.key）
# APP_ENCRYPTION_KEY=

# [可选] 审计日志文件容量上限（字节，默认 5242880 即 5MB，超出自动轮转）
# AUDIT_MAX_SIZE_BYTES=5242880

# [可选] wimotek/Oauth 统一认证 (OIDC 1.0 + OAuth 2.0 PKCE S256 + RS256 JWKS)
# 开启后自动使用 wimotek/Oauth 登录（禁用或 OAUTH_ENABLED=false 时自动回退到本地登录页）
# 亦可在 Web 后台「安全与容器设置」中动态开启/禁用与修改配置
# OAUTH_ENABLED=true
# OAUTH_ISSUER=http://ca.wimotek.com
# OAUTH_CLIENT_ID=wimotek_ebb129ddb83c
# OAUTH_SECRET=
# OAUTH_REDIRECT_URI=https://jp3.wimotek.com/auth/callback
# OAUTH_DIRECT_LOGIN=true
# OAUTH_ADMIN_EMAIL=

# [可选] 其他第三方 OAuth 登录与账号绑定（亦可在 Web 后台「安全与容器设置」中加密配置）
# 回调地址格式：<你的域名>/api/auth/oauth/{microsoft|github|google|apple}/callback
# APP_URL=https://jp3.wimotek.com
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# OAUTH_MICROSOFT_TENANT_ID=common
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_APPLE_CLIENT_ID=
# OAUTH_APPLE_TEAM_ID=
# OAUTH_APPLE_KEY_ID=
# OAUTH_APPLE_PRIVATE_KEY=
