# ==============================================================================
# NetPlus Cloud & DNS Console — Production Self-Hosted Environment Config
# ==============================================================================

# HTTP & Optional HTTPS Ports
PORT=3000
HTTPS_PORT=3443

# SSL Certificate Directory (mount Baota /certs:ro or auto-generate ECDSA self-signed in DATA_DIR/certs)
TLS_CERT_DIR=/certs
TLS_AUTO_SELF_SIGNED=true
TLS_SELF_SIGNED_CN=netpulse.local

# Persistent storage directory (encrypted cloud/DNS/SMTP secrets & audit.ndjson)
DATA_DIR=./data

# Optional fixed admin credentials (leave blank to use first-run web setup)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional 32-byte hex key for encrypting stored credentials at rest
APP_ENCRYPTION_KEY=

# Maximum audit log size in bytes before automatic FIFO pruning (default 5MB)
AUDIT_MAX_SIZE_BYTES=5242880
