#!/usr/bin/env bash
RC="$HOME/.config/tint2/tint2rc"
[ -f "$RC" ] || cp /etc/xdg/tint2/tint2rc "$RC" 2>/dev/null || exit 0

if grep -q "^panel_position = bottom " "$RC"; then
    sed -i 's/^panel_position = bottom /panel_position = top /' "$RC"
    sed -i 's/^border_sides = T$/border_sides = B/' "$RC"
else
    sed -i 's/^panel_position = top /panel_position = bottom /' "$RC"
    sed -i 's/^border_sides = B$/border_sides = T/' "$RC"
fi

pkill -x tint2 >/dev/null 2>&1 || true
