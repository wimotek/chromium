<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="Wimotek Workspace">
    <item label="🌐 New Chromium Window (Ctrl+Alt+N)">
      <action name="Execute">
        <command>/usr/local/bin/open-chromium</command>
      </action>
    </item>
    <item label="🕵️ New Incognito Window (Ctrl+Alt+I)">
      <action name="Execute">
        <command>/usr/local/bin/open-chromium --incognito</command>
      </action>
    </item>
    <item label="💻 Open Terminal (Ctrl+Alt+T)">
      <action name="Execute">
        <command>/usr/local/bin/open-terminal</command>
      </action>
    </item>
    <item label="📋 Clipboard Viewer / Manual Sync">
      <action name="Execute">
        <command>/usr/local/bin/show-clipboard</command>
      </action>
    </item>
    <separator/>
    <menu id="client-list-combined-menu"/>
    <item label="🖥️ Show Desktop / Minimize All (Win+D)">
      <action name="ToggleShowDesktop"/>
    </item>
    <item label="📐 Toggle Toolbar Position (Bottom / Top)">
      <action name="Execute">
        <command>/usr/local/bin/toggle-panel-pos</command>
      </action>
    </item>
    <item label="🔤 切换菜单语言 (English / 中文)">
      <action name="Execute">
        <command>/usr/local/bin/toggle-openbox-lang zh</command>
      </action>
    </item>
    <separator/>
    <item label="🔄 Restart Chromium">
      <action name="Execute">
        <command>/usr/local/bin/restart-chromium</command>
      </action>
    </item>
    <item label="⚙️ Reload Openbox &amp; Toolbar">
      <action name="Execute">
        <command>sh -c "openbox --reconfigure &amp;&amp; (pkill -x tint2 || true)"</command>
      </action>
    </item>
  </menu>
</openbox_menu>
