# Wimotek-Dark Openbox 3 Theme
# Sleek dark slate window decoration tailored for VNC browser workspaces

border.width: 1
padding.width: 8
padding.height: 5
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
menu.overlap.x: -2
menu.overlap.y: 0

# Window Borders
window.active.border.color: #38bdf8
window.inactive.border.color: #1e293b
window.active.client.color: #0f172a
window.inactive.client.color: #0f172a

# Active Titlebar
window.active.title.bg: flat solid
window.active.title.bg.color: #0f172a
window.active.label.bg: parentrelative
window.active.label.text.color: #f1f5f9
window.active.label.text.font: shadow=n

# Inactive Titlebar
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #1e293b
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #94a3b8
window.inactive.label.text.font: shadow=n

# Active Buttons
window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #cbd5e1
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #334155
window.active.button.hover.image.color: #38bdf8
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #0284c7
window.active.button.pressed.image.color: #ffffff
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #475569
window.active.button.toggled.unpressed.bg: parentrelative
window.active.button.toggled.unpressed.image.color: #38bdf8
window.active.button.toggled.hover.bg: flat solid
window.active.button.toggled.hover.bg.color: #334155
window.active.button.toggled.hover.image.color: #7dd3fc

# Inactive Buttons
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #64748b
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #334155
window.inactive.button.hover.image.color: #e2e8f0
window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #475569
window.inactive.button.pressed.image.color: #ffffff
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #334155

# Menus
menu.border.width: 1
menu.border.color: #334155
menu.items.bg: flat solid
menu.items.bg.color: #0f172a
menu.items.text.color: #e2e8f0
menu.items.disabled.text.color: #64748b
menu.items.active.bg: flat solid
menu.items.active.bg.color: #1e293b
menu.items.active.text.color: #38bdf8
menu.title.bg: flat solid
menu.title.bg.color: #020617
menu.title.text.color: #38bdf8
menu.title.text.justify: left
menu.separator.color: #1e293b
menu.separator.width: 1
menu.separator.padding.width: 6
menu.separator.padding.height: 4

# On-Screen Display (Alt+Tab)
osd.border.width: 1
osd.border.color: #38bdf8
osd.bg: flat solid
osd.bg.color: #0f172a
osd.label.bg: parentrelative
osd.label.text.color: #f1f5f9
osd.hilight.bg: flat solid
osd.hilight.bg.color: #1e293b
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #0f172a
