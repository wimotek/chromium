# Wimotek Compact Dark Toolbar for Openbox (tint2)

#-------------------------------------
# Backgrounds
# Background 1: Panel bar
rounded = 0
border_width = 1
border_sides = T
background_color = #0f172a 98
border_color = #1e293b 100

# Background 2: Inactive taskbar item
rounded = 6
border_width = 0
background_color = #1e293b 45
border_color = #000000 0

# Background 3: Active taskbar item
rounded = 6
border_width = 2
border_sides = B
background_color = #1e293b 100
border_color = #38bdf8 100

# Background 4: Urgent taskbar item
rounded = 6
border_width = 2
border_sides = B
background_color = #7c2d12 90
border_color = #fb923c 100

# Background 5: Tooltip
rounded = 6
border_width = 1
background_color = #020617 98
border_color = #334155 100

#-------------------------------------
# Panel
panel_items = LTSC
panel_size = 100% 36
panel_margin = 0 0
panel_padding = 8 4 8
panel_background_id = 1
wm_menu = 1
panel_dock = 0
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
strut_policy = follow_size
panel_window_name = tint2
autohide = 0
disable_transparency = 0
mouse_effects = 1
font_shadow = 0

#-------------------------------------
# Launcher (Quick Actions)
launcher_padding = 4 2 6
launcher_background_id = 0
launcher_icon_background_id = 0
launcher_icon_size = 20
launcher_icon_asb = 100 0 0
launcher_icon_theme_override = 0
startup_notifications = 0
launcher_tooltip = 1
launcher_item_app = /usr/share/applications/wimotek-chrome.desktop
launcher_item_app = /usr/share/applications/wimotek-incognito.desktop
launcher_item_app = /usr/share/applications/wimotek-terminal.desktop
launcher_item_app = /usr/share/applications/wimotek-clipboard.desktop
launcher_item_app = /usr/share/applications/wimotek-restart-chrome.desktop

#-------------------------------------
# Taskbar
taskbar_mode = single_desktop
taskbar_hide_if_empty = 0
taskbar_padding = 4 2 6
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 1
taskbar_hide_inactive_tasks = 0
taskbar_hide_different_monitor = 0
taskbar_always_show_all_desktop_tasks = 0
taskbar_name_padding = 8 2
taskbar_name_background_id = 2
taskbar_name_active_background_id = 2
taskbar_name_font = WenQuanYi Zen Hei Bold 9
taskbar_name_font_color = #94a3b8 100
taskbar_name_active_font_color = #38bdf8 100
taskbar_distribute_size = 0
taskbar_sort_order = none
task_align = left

#-------------------------------------
# Task buttons
task_text = 1
task_icon = 1
task_centered = 0
urgent_nb_of_blink = 100000
task_maximum_size = 240 28
task_padding = 8 2 6
task_font = WenQuanYi Zen Hei 9
task_tooltip = 1
task_thumbnail = 0
task_font_color = #cbd5e1 100
task_active_font_color = #f8fafc 100
task_urgent_font_color = #fed7aa 100
task_icon_asb = 100 0 0
task_background_id = 2
task_active_background_id = 3
task_urgent_background_id = 4
mouse_left = toggle_iconify
mouse_middle = close
mouse_right = toggle_maximize
mouse_scroll_up = toggle
mouse_scroll_down = iconify

#-------------------------------------
# System tray (notification area)
systray_padding = 4 2 6
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 18
systray_icon_asb = 100 0 0
systray_monitor = 1

#-------------------------------------
# Clock
time1_format = %H:%M  %m-%d
time1_font = WenQuanYi Zen Hei Bold 9
time1_timezone =
clock_font_color = #e2e8f0 100
clock_padding = 8 2
clock_background_id = 0
clock_tooltip = %Y-%m-%d %A %H:%M:%S
clock_lclick_command = /usr/local/bin/show-clipboard

#-------------------------------------
# Tooltip
tooltip_show_timeout = 0.4
tooltip_hide_timeout = 0.1
tooltip_padding = 8 5
tooltip_background_id = 5
tooltip_font_color = #f1f5f9 100
tooltip_font = WenQuanYi Zen Hei 9
