# wimotek/ca Environment Variables (Pure Production · All variables have safe built-in defaults)

# Built-in HTTPS server settings
CA_TLS_ENABLED="true"
CA_LISTEN_ADDR=":8443"
CA_BASE_URL="https://localhost:8443"
CA_ORG_NAME="Wimotek Enterprise"

# Storage & read-only TLS certificate mount directories
CA_DATA_DIR="/data"
CA_CERTS_DIR="/certs"
# Optional: extra SAN DNS names or IPs for auto-generated TLS cert (comma-separated)
CA_TLS_HOSTS=""

# Admin authentication
CA_ADMIN_USER="admin"
# Optional: leave empty on first run to claim admin password via Web UI
CA_ADMIN_PASSWORD=""
# Optional: 32-byte hex master key (auto-persisted in /data/.master.key when empty)
CA_MASTER_KEY=""

# Database ("sqlite" default, or "mysql")
CA_DB_DRIVER="sqlite"
CA_DB_DSN="/data/wimotek-ca.db"
# Example MySQL DSN:
# CA_DB_DSN="ca_user:ca_pass@tcp(127.0.0.1:3306)/wimotek_ca?parseTime=false&multiStatements=true"

# Optional HybridCache Redis backend (seamlessly degrades to SQL cache_kv when empty/offline)
CA_REDIS_ADDR=""
CA_REDIS_PASSWORD=""
CA_REDIS_TLS="false"
CA_REDIS_TLS_INSECURE="false"

# Optional offline SHA-256 PoW difficulty (leading zero bits, 8-24, default 16)
CA_POW_DIFFICULTY="16"

# Optional background expiry notification scan interval in minutes (default 60)
CA_NOTIFY_INTERVAL_MIN="60"
# Optional: allow private/LAN webhook targets for internal notification relays (default false)
CA_ALLOW_PRIVATE_WEBHOOKS="false"

# Primary: Unified wimotek/oauth Login Gateway + IdP (PKCE S256)
WIMOTEK_OAUTH_ISSUER="https://ais-dev-mjxg7khj3qsigvnmjpozen-587929382584.asia-northeast1.run.app"
WIMOTEK_OAUTH_CLIENT_ID="wimotek_ca"
WIMOTEK_OAUTH_CLIENT_SECRET=""
WIMOTEK_OAUTH_SCOPES="openid profile email"

# Optional: Direct Social OAuth fallback (Microsoft Entra ID / GitHub / Google)
OAUTH_MICROSOFT_CLIENT_ID=""
OAUTH_MICROSOFT_CLIENT_SECRET=""
OAUTH_MICROSOFT_TENANT_ID="common"
OAUTH_GITHUB_CLIENT_ID=""
OAUTH_GITHUB_CLIENT_SECRET=""
OAUTH_GOOGLE_CLIENT_ID=""
OAUTH_GOOGLE_CLIENT_SECRET=""

# Optional: System SMTP for Email Verification & Email 2FA OTP
CA_SMTP_HOST=""
CA_SMTP_PORT="587"
CA_SMTP_USER=""
CA_SMTP_PASSWORD=""
CA_SMTP_FROM=""

