/**
 * Ambient type shims for Node.js built-ins.
 * Allows zero-dependency compilation in fresh CI runners where @types/node may not be installed.
 */

declare module 'child_process' {
  export interface ChildProcess {
    pid?: number;
    exitCode: number | null;
    kill(signal?: string): boolean;
    on(event: string, listener: (...args: any[]) => void): this;
  }
  export function spawn(command: string, args?: readonly string[], options?: any): ChildProcess;
}

declare module 'fs' {
  export function writeFileSync(path: string, data: string | Uint8Array, options?: any): void;
  export function existsSync(path: string): boolean;
  export function unlinkSync(path: string): void;
}

declare module 'net' {
  export class Socket {
    setTimeout(timeout: number): this;
    once(event: string, listener: (...args: any[]) => void): this;
    destroy(): this;
    connect(port: number, host: string, connectionListener?: () => void): this;
  }
}

declare module 'os' {
  export function tmpdir(): string;
}

declare module 'path' {
  export function join(...paths: string[]): string;
}

declare var process: {
  env: Record<string, string | undefined>;
  argv: string[];
  exit(code?: number): never;
  on(event: string, listener: (...args: any[]) => void): any;
};
